{
  "meta": {
    "name": "campaign-vm",
    "description": "Broad guest filesystem access, keeping nono's own state private, with filtered campaign networking"
  },
  "filesystem": {
    "allow": [
      "/usr", "/etc", "/opt", "/tmp", "/var", "/run", "/dev", "/proc", "/sys",
      "$HOME/campaigns", "$HOME/.local/bin", "$HOME/.local/share",
      "$HOME/.config", "$HOME/.cache", "$HOME/.cargo", "$HOME/.rustup",
      "$HOME/go", "$HOME/.agents", "$HOME/.claude", "$HOME/.codex", "$HOME/.local/state/opencode",
      "$HOME/.docker", "$HOME/.kube", "$HOME/.opam"
    ],
    "read": ["/home/linuxbrew/.linuxbrew"],
    "allow_file": ["$HOME/.claude.json", "$HOME/.gitconfig"],
    "bypass_protection": ["$HOME/.config", "$HOME/.local/share", "$HOME/.docker", "$HOME/.kube"]
  },
  "network": {
    "network_profile": "developer",
    "allow_domain": ["proxy.golang.org", "sum.golang.org"]
  },
  "linux": {
    "isolate": { "network": true, "loopback": true }
  }
}
