{
  "description": "Reject known model/version confusions before a tool can persist them.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/reject-model-confusions.sh\"",
            "timeout": 5,
            "statusMessage": "Checking known model confusions"
          }
        ]
      }
    ]
  }
}
